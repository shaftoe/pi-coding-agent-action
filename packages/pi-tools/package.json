{
  "name": "@alexanderfortin/pi-coding-agent-action-tools",
  "version": "0.1.0",
  "description": "Reusable tool definitions for the Pi coding agent – create/update PRs and fetch issue/PR threads",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "format": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "validate": "bun run type-check && bun run format",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "github",
    "pull-request",
    "tools"
  ],
  "author": "Alexander Fortin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaftoe/pi-coding-agent-action.git",
    "directory": "packages/pi-tools"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@mariozechner/pi-coding-agent": "^0.67.68",
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
